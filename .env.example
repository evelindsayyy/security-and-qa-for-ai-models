# Repo-wide secrets. Copy to .env (gitignored) and paste your tokens.
# One file for the whole repo — every Docker stack and host script reads it.
# Models are chosen on the CLI / in the UI, never here.
#
# Host-specific values (user id, Docker socket group, repo path) are auto-detected
# by ./docker/run.sh and ./docker/build-pillars.sh — you do not set them here.

# --- Duke AI Gateway (LiteLLM) -------------------------------------------------
# The one gateway key the project uses. The OPENAI_* aliases point tools (OpenAI
# SDK, promptfoo, garak, benchmarks) at the same endpoint and token.
DUKE_GATEWAY_URL="https://litellm.oit.duke.edu/v1"
DUKE_GATEWAY_KEY="your_duke_litellm_token_here"
OPENAI_BASE_URL="https://litellm.oit.duke.edu/v1"
OPENAI_API_KEY="your_duke_litellm_token_here"

# --- Hugging Face (scanner) ----------------------------------------------------
# Token for gated/private downloads only. Public models (gpt2, distilbert): blank.
HF_TOKEN=""

# --- Promptfoo options ---------------------------------------------------------
PROMPTFOO_DISABLE_TELEMETRY=1
PROMPTFOO_DISABLE_UPDATE=1

# --- App UI options (optional) -------------------------------------------------
# Host port for the containerized UI (./docker/run.sh).
APP_PORT=5000
# Pillar jobs from Start buttons use Docker by default (FRONTEND_LAUNCH_MODE=docker).
# Set to "host" only for legacy dev without Docker job launches:
# FRONTEND_LAUNCH_MODE=host

# --- Microsoft Foundry examples (scripts/azure/) -------------------------------
# Only for the Azure Foundry demo scripts; unrelated to the Duke gateway.
FOUNDRY_BASE_URL="https://your-foundry-resource.services.ai.azure.com/openai/v1"
FOUNDRY_API_KEY="your_foundry_api_key_here"
FOUNDRY_MODEL="DeepSeek-V4-Flash"

# --- Postgres ------------------------------------------------------------------
# Real credentials from the team lead — do not commit. Duke Postgres requires TLS;
# keep ?sslmode=require on the DSN. Works from DGX, application VM, or VPN when
# the network allows. Set EFFICACY_DB_DSN to the same value as POSTGRES_DSN.
POSTGRES_DSN="postgresql://YOUR_USER:YOUR_PASSWORD@codeplus-postgres-test-01.oit.duke.edu:5432/qa_ai_models?sslmode=require"
EFFICACY_DB_DSN="postgresql://YOUR_USER:YOUR_PASSWORD@codeplus-postgres-test-01.oit.duke.edu:5432/qa_ai_models?sslmode=require"
# Auto-sync each successful pillar run into Postgres when a DSN is set (default on).
# AUTO_INGEST=0
