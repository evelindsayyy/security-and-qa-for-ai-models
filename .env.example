# Repo-wide secrets. Copy to .env (gitignored) and paste your tokens.
# One file for the whole repo — every Docker stack and host script reads it.
# Models are chosen on the CLI / in the UI, never here.

# --- Duke AI Gateway (LiteLLM) -------------------------------------------------
# Canonical gateway credentials. This is the one gateway key the project uses.
DUKE_GATEWAY_URL="https://litellm.oit.duke.edu/v1"
DUKE_GATEWAY_KEY="your_duke_litellm_token_here"

# OpenAI-SDK aliases: Same endpoint and token, under the names some tools
# require (OpenAI SDK, promptfoo, garak, public benchmarks). Keep them equal to
# the two values above — do not use a different key here.
OPENAI_BASE_URL="https://litellm.oit.duke.edu/v1"
OPENAI_API_KEY="your_duke_litellm_token_here"

# --- Hugging Face (scanner) ----------------------------------------------------
# Token for gated/private downloads only. Public models (gpt2, distilbert): leave blank.
HF_TOKEN=""

# --- Microsoft Foundry examples (scripts/azure/) -------------------------------
# Unrelated to the Duke gateway; only needed for the Azure Foundry demo scripts.
# Use the deployed model name for FOUNDRY_MODEL, e.g. DeepSeek-V4-Flash.
FOUNDRY_BASE_URL="https://your-foundry-resource.services.ai.azure.com/openai/v1"
FOUNDRY_API_KEY="your_foundry_api_key_here"
FOUNDRY_MODEL="DeepSeek-V4-Flash"

# --- Shared Postgres (all pillars) ---------------------------------------------
# Same database/login for scanner, safety, benchmarks, and efficacy ingest.
# Firewalled — Duke network/VPN required from laptops; application VM has route.
# Never commit a real password.
POSTGRES_DSN="postgresql://USER:PASSWORD@codeplus-postgres-test-01.oit.duke.edu:5432/qa_ai_models"

# --- Efficacy Postgres (evaluator/db/) -----------------------------------------
# Only needed for `evaluator/db/load_results.py --apply` and the dashboard's
# optional DB read path. The server is firewalled (Duke network/VPN required).
# Never commit a real password.
EFFICACY_DB_DSN="postgresql://USER:PASSWORD@codeplus-postgres-test-01.oit.duke.edu:5432/qa_ai_models"
