# Copy to .env and paste secrets. Host UID/GID and repo path are auto-detected
# by ./docker/run.sh — do not set them here.

# Duke AI Gateway (LiteLLM) — one key for the whole repo
DUKE_GATEWAY_URL=https://litellm.oit.duke.edu/v1
DUKE_GATEWAY_KEY=your_duke_litellm_token_here
OPENAI_BASE_URL=https://litellm.oit.duke.edu/v1
OPENAI_API_KEY=your_duke_litellm_token_here

# Hugging Face — required for gated/private repos; strongly recommended for
# large public downloads (anonymous Hub access is rate-limited and flaky).
HF_TOKEN=
# Optional: raise for huge mirrors (default 80). Multi-GB scans also need free disk.
# SCAN_MAX_MODEL_GB=80
# HF_HUB_DOWNLOAD_TIMEOUT=300
# HF_HUB_ETAG_TIMEOUT=60
# Parallel HF/Xet downloads (1–8). On hosts with <8 GiB MemAvailable the scanner
# defaults to 1 to avoid OOM mid-download (e.g. 70B shards on a 5 GiB VCM).
# SCAN_HF_MAX_WORKERS=1
# Scanner weights: Docker uses a named volume on the daemon data root (usually /),
# so large HF downloads are not capped by a small /home repo partition.
# Bind a host path instead (must have enough free space for the model + ~20%):
# SCANNER_MODELS_HOST_PATH=/var/lib/qa-ai-models/scanner-models
# Host-mode (no Docker): MODELS_ROOT=/var/lib/qa-ai-models/scanner-models

# Promptfoo (safety pillar)
PROMPTFOO_DISABLE_TELEMETRY=1
PROMPTFOO_DISABLE_UPDATE=1

# App UI
APP_PORT=5000
FRONTEND_LAUNCH_MODE=docker
# Remote dev: ssh -L 5000:localhost:5000 <user>@<host> → http://localhost:5000 (see auth/README.md)

# HTTPS reverse proxy (production VM only; see docker/compose.caddy.yml)
# DGX/local: leave CADDY_DOMAIN blank, TRUST_PROXY=0
# VM: CADDY_DOMAIN=model-advisor.colab.duke.edu, TRUST_PROXY=1
CADDY_DOMAIN=
CADDY_EMAIL=your-netid@duke.edu
CADDY_ACME_HOSTNAME=locksmith.oit.duke.edu
CADDY_BACKEND_PORT=5000
TRUST_PROXY=0

# Auth — Duke OIDC (see auth/README.md)
# Registered client: codeplus-model-advisor
AUTH_ENABLED=0
SECRET_KEY=change-me-to-a-long-random-string
DUKE_OIDC_CLIENT_ID=codeplus-model-advisor
DUKE_OIDC_CLIENT_SECRET=your_client_secret_from_1password
# Leave blank to infer from CADDY_DOMAIN in production, or the current local host in dev.
# Local dev:  http://127.0.0.1:5000/login or http://localhost:5000/login
# Production: https://model-advisor.colab.duke.edu/login
DUKE_OIDC_REDIRECT_URI=
# Comma-separated netIDs, no spaces (private mode + custom runs)
AUTH_ALLOWED_NETIDS=yournetid,teammate1
# When AUTH_ENABLED=0, simulates login for private-mode UI testing
AUTH_DEV_NETID=yournetid

# Postgres — Duke requires TLS (?sslmode=require). Set EFFICACY_DB_DSN same as POSTGRES_DSN.
POSTGRES_DSN=postgresql://YOUR_USER:YOUR_PASSWORD@codeplus-postgres-test-01.oit.duke.edu:5432/qa_ai_models?sslmode=require
EFFICACY_DB_DSN=postgresql://YOUR_USER:YOUR_PASSWORD@codeplus-postgres-test-01.oit.duke.edu:5432/qa_ai_models?sslmode=require

# Optional: set AUTO_INGEST=0 to skip auto-sync after each run (default is on when DSN is set)

# Optional: Azure Foundry demo scripts only (scripts/azure/) — unrelated to Duke gateway
FOUNDRY_BASE_URL=https://your-foundry-resource.services.ai.azure.com/openai/v1
FOUNDRY_API_KEY=your_foundry_api_key_here
FOUNDRY_MODEL=DeepSeek-V4-Flash
