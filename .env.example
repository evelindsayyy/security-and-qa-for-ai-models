# Copy to .env and paste secrets. Host UID/GID and repo path are auto-detected
# by ./docker/run.sh — do not set them here.

# Duke AI Gateway (LiteLLM) — one key for the whole repo
DUKE_GATEWAY_URL=https://litellm.oit.duke.edu/v1
DUKE_GATEWAY_KEY=your_duke_litellm_token_here
OPENAI_BASE_URL=https://litellm.oit.duke.edu/v1
OPENAI_API_KEY=your_duke_litellm_token_here

# Hugging Face — gated/private downloads only; leave blank for public models
HF_TOKEN=

# Promptfoo (safety pillar)
PROMPTFOO_DISABLE_TELEMETRY=1
PROMPTFOO_DISABLE_UPDATE=1

# App UI
APP_PORT=5000
FRONTEND_LAUNCH_MODE=docker

# Auth — Duke OIDC (see docs/auth-setup.md for OIT registration)
AUTH_ENABLED=0
SECRET_KEY=change-me-to-a-long-random-string
DUKE_OIDC_CLIENT_ID=
DUKE_OIDC_CLIENT_SECRET=
DUKE_OIDC_REDIRECT_URI=http://model-advisor.colab.duke.edu:5000/auth/callback
# Comma-separated netIDs allowed for private mode and custom runs
AUTH_ALLOWED_NETIDS=
# Local dev bypass when AUTH_ENABLED=0 (optional)
AUTH_DEV_NETID=

# Postgres — Duke requires TLS (?sslmode=require). Set EFFICACY_DB_DSN same as POSTGRES_DSN.
POSTGRES_DSN=postgresql://YOUR_USER:YOUR_PASSWORD@codeplus-postgres-test-01.oit.duke.edu:5432/qa_ai_models?sslmode=require
EFFICACY_DB_DSN=postgresql://YOUR_USER:YOUR_PASSWORD@codeplus-postgres-test-01.oit.duke.edu:5432/qa_ai_models?sslmode=require

# Optional: set AUTO_INGEST=0 to skip auto-sync after each run (default is on when DSN is set)

# Optional: Azure Foundry demo scripts only (scripts/azure/) — unrelated to Duke gateway
FOUNDRY_BASE_URL=https://your-foundry-resource.services.ai.azure.com/openai/v1
FOUNDRY_API_KEY=your_foundry_api_key_here
FOUNDRY_MODEL=DeepSeek-V4-Flash
