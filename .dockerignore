# Narrow build context for pillar + app images.
# Runtime dirs are bind-mounted at `docker compose run` time.

# Exclude everything, then whitelist source trees needed for builds.
**
!pyproject.toml
!uv.lock
!main.py
!frontend/
!frontend/**
!gateway/
!gateway/**
!dbutils/
!dbutils/**
!scanner/
!scanner/**
!evaluator/
!evaluator/**
!benchmarks/
!benchmarks/**
!safety/
!safety/**
!docker/
!docker/**

# Re-exclude large or permission-sensitive runtime trees (incl. root-owned garak caches)
scanner/models
scanner/output
evaluator/results
evaluator/cache
benchmarks/results
safety/garak/output
safety/garak/output/**
safety/promptfoo/output
safety/promptfoo/output/**
safety/output
safety/output/**
safety/garak_testing/output
safety/promptfoo_testing/output
**/__pycache__
