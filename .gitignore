# Ignore the python & local virtual environment
venv/
.venv/
**/.venv/
.env
scanner/docker/.env

# Ignore system files
.DS_Store
__pycache__/

# scanner runtime data (VM bind mount) — not in git except README
scanner/models/*
!scanner/models/README.md
scanner/output/*
!scanner/output/README.md

# legacy / repo-root output (remote + old scanning layout on disk)
output/
testing/scanning/models/*
!testing/scanning/models/README.md
testing/scanning/output/*
!testing/scanning/output/README.md

.gitlab/gitlab-transfer.md

# eval spikes — regenerate locally
testing/eval/output/*
!testing/eval/output/README.md
!testing/eval/output/samples/
!testing/eval/output/samples/**

# never commit keys
**/sk-*.txt
jack/

# Flask local folder (auto-created at repo root: config.py, frontend.sqlite)
instance/

# Ignore tqa test results
test_results/

# Evaluator cache — regenerable, large, contains responses
evaluator/cache/
evaluator/results/

# AI-only briefings — personal notes for Claude, not project documentation
evaluator/CLAUDE.md
evaluator/TASK.md
output/
gen_options.json

# Model caches
.cache/
