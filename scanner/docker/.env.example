# cp .env.example .env  then set UID/GID (do not use 1000 on DGX):
#   sed -i "s/^UID=.*/UID=$(id -u)/" .env && sed -i "s/^GID=.*/GID=$(id -g)/" .env

UID=1000
GID=1000
MODEL_ID=distilbert-base-uncased

# Public Hub models (gpt2, distilbert): leave commented out.
# Gated/private models: token from https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...
