# cp safety/garak/docker/.env.example safety/garak/docker/.env
# Then set UID/GID to your current machine so generated output files are editable.
#
# Linux/DGX:
#   sed -i "s/^UID=.*/UID=$(id -u)/" safety/garak/docker/.env
#   sed -i "s/^GID=.*/GID=$(id -g)/" safety/garak/docker/.env

UID=1000
GID=1000

# Optional pin, e.g. GARAK_VERSION=0.10.0
GARAK_VERSION=

# Duke AI Gateway token — same as DUKE_GATEWAY_KEY / OPENAI_API_KEY in repo .env.
OPENAICOMPATIBLE_API_KEY=your_duke_litellm_token_here
OPENAI_API_KEY=your_duke_litellm_token_here

# LiteLLM model id for garak -n flag (see docs/gateway-models.md)
GATEWAY_MODEL=GPT 4.1 Mini
