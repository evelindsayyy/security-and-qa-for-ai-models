# cp safety/promptfoo/docker/.env.example safety/promptfoo/docker/.env
# Then set UID/GID to your current machine so generated output files are editable.
#
# macOS:
#   sed -i '' "s/^UID=.*/UID=$(id -u)/" safety/promptfoo/docker/.env
#   sed -i '' "s/^GID=.*/GID=$(id -g)/" safety/promptfoo/docker/.env
#
# Linux/DGX:
#   sed -i "s/^UID=.*/UID=$(id -u)/" safety/promptfoo/docker/.env
#   sed -i "s/^GID=.*/GID=$(id -g)/" safety/promptfoo/docker/.env

UID=1000
GID=1000

# Use "latest" for the newest Promptfoo release, or pin a version for reproducibility.
PROMPTFOO_VERSION=latest

# Duke AI Gateway / LiteLLM-compatible OpenAI endpoint.
# Same token as DUKE_GATEWAY_KEY in the repo-root .env.
OPENAI_BASE_URL=https://litellm.oit.duke.edu/v1
OPENAI_API_KEY=your_duke_litellm_token_here

# Keep red-team generation local to the configured provider.
# Set false only if you intentionally want Promptfoo-managed remote generation.
PROMPTFOO_DISABLE_REDTEAM_REMOTE_GENERATION=true

PROMPTFOO_REPORT_PORT=15500
